  "item": [
    {
      "name": "01 Login admin OK",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/auth/login",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@sece.local\",\n  \"password\": \"Admin1234!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve access_token\", () => {",
              "    const j = pm.response.json();",
              "    pm.expect(j).to.have.property(\"access_token\");",
              "    pm.expect(j.token_type).to.eql(\"bearer\");",
              "    pm.expect(j.rol).to.eql(\"ADMIN\");",
              "    pm.environment.set(\"admin_token\", j.access_token);",
              "});",
              "pm.test(\"Tiempo < 500ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
